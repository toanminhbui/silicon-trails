{
  "name": "silicon-trails",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "An explorable computer architecture workshop with live RTL synthesis.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "generate:examples": "node --wasm-num-compilation-tasks=1 --liftoff-only scripts/generate-examples.mjs",
    "predev": "node scripts/prepare-yosys.mjs",
    "prebuild": "node scripts/prepare-yosys.mjs"
  },
  "dependencies": {
    "@yowasp/yosys": "0.47.804",
    "three": "^0.180.0",
    "codemirror": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/language": "^6.11.3"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "@playwright/test": "^1.56.0"
  }
}
